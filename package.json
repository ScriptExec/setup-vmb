{
  "name": "setup-vmb",
  "version": "1.0.0",
  "description": "Set up GitHub Actions workflow with a specific version of vmb.",
  "license": "MIT",
  "author": "ScriptExec",
  "config": {
    "repositoryUrl": "https://github.com/ScriptExec/vmb",
    "defaultReleaseVersion": "latest"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --noEmit && ncc build src/index.ts --minify -o dist",
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@vercel/ncc": "^0.38.4",
    "@types/node": "^25.6.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/tool-cache": "^4.0.0"
  }
}
